# Required. Never commit real values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SOLANA_RPC_URL=
# Public address of the dedicated ArbiVault revenue treasury; no private key needed here.
SOLANA_TREASURY_ADDRESS=
# Fixed price in lamports. 1 SOL = 1,000,000,000 lamports. Must be a positive integer.
SOLANA_REPORT_PRICE_LAMPORTS=
# Must be mainnet-beta for production; local development is not enabled by this service by default.
SOLANA_NETWORK=mainnet-beta
SOLANA_INVOICE_TTL_SECONDS=900
PORT=4567
